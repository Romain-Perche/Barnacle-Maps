{
  "version": 1,
  "zones": [
    {"id": "dev-host", "label": "Local host running the static server"},
    {"id": "browser", "label": "User's browser"},
    {"id": "osm", "label": "OpenStreetMap services (third party)"},
    {"id": "cdn", "label": "unpkg CDN (third party)"}
  ],
  "actors": [
    {"id": "user", "label": "Browser user"},
    {"id": "geolocation", "label": "Browser geolocation (device position)", "zone": "browser"},
    {"id": "phone", "label": "User's phone camera"},
    {"id": "unpkg", "label": "unpkg CDN (Leaflet, qrcode-generator)", "zone": "cdn"},
    {"id": "osm-tiles", "label": "OSM tile server (tile.openstreetmap.org)", "zone": "osm"},
    {"id": "nominatim", "label": "Nominatim geocoding", "zone": "osm"},
    {"id": "osrm", "label": "OSRM routing (routing.openstreetmap.de)", "zone": "osm"},
    {"id": "osm-directions", "label": "OSM directions page (www.openstreetmap.org)", "zone": "osm"}
  ],
  "processes": [
    {"id": "static-server", "label": "Static file server (python http.server)", "zone": "dev-host", "sources": ["package.json", "index.html"]},
    {"id": "web-app", "label": "Barnacle Maps web app", "zone": "browser", "sources": ["src/app.js", "src/geo.js", "src/qr.js"]}
  ],
  "stores": [],
  "flows": [
    {"from": "static-server", "to": "web-app", "data": "HTML, CSS and app JavaScript", "sources": ["package.json", "index.html"]},
    {"from": "unpkg", "to": "web-app", "data": "Leaflet and qrcode-generator scripts (SRI pinned)", "sources": ["index.html", "pins.json"]},
    {"from": "user", "to": "web-app", "data": "search text, picked place, stops, travel mode", "sources": ["src/app.js"]},
    {"from": "geolocation", "to": "web-app", "data": "live latitude and longitude", "sources": ["src/app.js"]},
    {"from": "web-app", "to": "nominatim", "data": "place search query", "sources": ["src/geo.js", "src/app.js"]},
    {"from": "nominatim", "to": "web-app", "data": "matching places with coordinates", "sources": ["src/geo.js", "src/app.js"]},
    {"from": "web-app", "to": "osrm", "data": "start, stops, detour and destination coordinates", "sources": ["src/geo.js", "src/app.js"]},
    {"from": "osrm", "to": "web-app", "data": "routes: geometry, distance, duration", "sources": ["src/geo.js", "src/app.js"]},
    {"from": "osm-tiles", "to": "web-app", "data": "map tiles, also read for green-pixel pleasure score", "sources": ["src/app.js", "src/geo.js"]},
    {"from": "web-app", "to": "user", "data": "map, routes, status, pleasure score", "sources": ["src/app.js", "index.html"]},
    {"from": "web-app", "to": "phone", "data": "QR code of the OSM directions link", "sources": ["src/qr.js", "src/app.js"]},
    {"from": "web-app", "to": "osm-directions", "data": "start, destination and mode in the phone link", "sources": ["src/geo.js", "src/app.js"]}
  ]
}
